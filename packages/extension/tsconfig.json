{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "types": ["chrome"],
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo",
    "paths": {
    "@san/shared": ["../shared/src"],
    "@san/shared/*": ["../shared/src/*"],
    "@san/ui": ["../ui/src"],
    "@san/ui/*": ["../ui/src/*"]
    }
  },
  "include": [
    "src/**/*",
    "../shared/src/**/*"
, "../ui/src/components/Button/CurvedButton.tsx"  ],
  "exclude": ["node_modules", "dist"]
}
