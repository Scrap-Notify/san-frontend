{
  "manifest_version": 3,
  "name": "SAN - 지식 창고",
  "version": "1.0.0",
  "permissions": [
    "sidePanel",
    "storage",
    "tabs",
    "activeTab",
    "scripting",
    "contextMenus"
  ],
  "host_permissions": [
    "http://localhost:5173/*", 
    "http://localhost:5174/*",
    "http://localhost:8080/*",
    "https://k14a309.p.ssafy.io/*"
  ], 
  "externally_connectable": {
    "matches": [
      "http://localhost:5173/*",
      "http://localhost:5174/*",
      "https://k14a309.p.ssafy.io/*"
    ]
  },
  "action": {
    "default_icon": "icons.svg" 
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+S",
        "mac": "Alt+S"
      }
    }
  },
  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/content/index.ts"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  }
}
