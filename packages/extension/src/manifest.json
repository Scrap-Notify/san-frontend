{
  "manifest_version": 3,
  "name": "SAN - 지식 창고",
  "version": "1.0.0",
  "permissions": [
    "sidePanel",
    "storage",
    "tabs",
    "activeTab",
    "scripting",
    "contextMenus"
  ],
  "host_permissions": [
    "http://localhost/*",
    "https://k14a309.p.ssafy.io/*"
  ], 
  "externally_connectable": {
    "matches": [
      "http://localhost/*",
      "https://k14a309.p.ssafy.io/*"
    ]
  },
  "icons": {
    "16": "favicon.svg",
    "48": "favicon.svg",
    "128": "favicon.svg"
  },
  "action": {
    "default_icon": "favicon.svg" 
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+S",
        "mac": "Alt+S"
      },
      "description": "SAN 사이드패널 열기/닫기"
    },
    "capture_image": {
      "suggested_key": {
        "default": "Alt+Q",
        "mac": "Alt+Q"
      },
      "description": "현재 탭(전체 화면)을 이미지로 캡처"
    }
  },
  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/content/index.ts"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "web_accessible_resources": [
  {
    "resources": ["fonts/*.woff"],
    "matches": ["<all_urls>"]
  }
]
}
